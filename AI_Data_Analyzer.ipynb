      "source": [
        "class Ai_Data_Analyzer:\n",
        "  def __init__(self):\n",
        "    self.csv_name=None\n",
        "    self.choice=None\n",
        "  def Load_Dataset(self):\n",
        "    try:\n",
        "      Data=input(\"Enter the CSV Dataset path:\")\n",
        "      self.csv_name=pd.read_csv(Data)\n",
        "      print(\"=======Dataset Loaded=======\")\n",
        "    except Exception as e:\n",
        "      print(\"Could Not Load the File.Details:\",e)\n",
        "      self.csv_name=None\n",
        "      return\n",
        "  def basic_info(self):\n",
        "    while True:\n",
        "      try:\n",
        "        user=int(input(\"Do Want Basic Info?\\n\"\n",
        "                       \"Enter:\\n\"\n",
        "                       \"1 for Yes\\n\"\n",
        "                       \"2 for No\\n\"))\n",
        "      except ValueError:\n",
        "        print(\"Invalid input! Enter a number from 1 or 2.\")\n",
        "        continue\n",
        "      if user==1:\n",
        "        print(\"=========Basic Info=========\")\n",
        "        print(\"First 5 Records:\")\n",
        "        print(self.csv_name.head())\n",
        "        print(\"Number of Columns of Dataset:\")\n",
        "        print(len(self.csv_name.columns))\n",
        "        print(\"Rows of Dataset:\")\n",
        "        print(len(self.csv_name.index))\n",
        "        print(\"Names of Columns of Dataset:\")\n",
        "        print(*self.csv_name.columns,sep=\"\\n\")\n",
        "        print(\"Number of Missing Values:\")\n",
        "        print(self.csv_name.isna().sum())\n",
        "        print(\"Duplicate Rows:\")\n",
        "        print(self.csv_name.duplicated().sum())\n",
        "        break\n",
        "      elif user == 2:\n",
        "        break\n",
        "      else:\n",
        "        print(\"invalid input!Enter Number 1 or 2\")\n",
        "  def cleaning_Data(self):\n",
        "    if self.csv_name is None:\n",
        "      print(\"No dataset loaded yet. Please run Load Dataset with Basic info and Enter the Dataset Path and Name, first.\")\n",
        "      return\n",
        "    Before_Cleaning={\n",
        "    \"Rows\":len(self.csv_name.index),\n",
        "    \"Missing Values\":self.csv_name.isna().sum().to_dict(),\n",
        "    \"Duplicate Rows\":int(self.csv_name.duplicated().sum())\n",
        "    }\n",
        "    print(\"===Cleaning Data===\\n\")\n",
        "    def handle_nulls():\n",
        "      print(\"===Handle Null Values===\")\n",
        "      y=input(\"Enter the column name to fix the missing Value:\")\n",
        "      if y not in self.csv_name.columns:\n",
        "        print(\"No Column Exist With Name:\",y)\n",
        "        return\n",
        "      while True:\n",
        "        if pd.api.types.is_numeric_dtype(self.csv_name[y]):\n",
        "          try:\n",
        "            self.choice=int(input(\"Enter:\\n\"\n",
        "                             \"1 for Enter value manually.\\n\"\n",
        "                             \"2 for Fill missing values with Average.\\n\"\n",
        "                             \"3 for Fill The missing values with Median.\\n\"\n",
        "                             \"4 for Fill The missing values with Minimun.\\n\"\n",
        "                             \"Choose 1,2,3 or 4:\"))\n",
        "          except ValueError:\n",
        "            print(\"Invalid input! Enter a number from 1 to 4.\")\n",
        "            continue\n",
        "          if self.choice==1:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              while True:\n",
        "                try:\n",
        "                  x=float(input(\"Enter the Missing Value:\"))\n",
        "                  break\n",
        "                except ValueError:\n",
        "                  print(\"Invalid input! Enter a number.\")\n",
        "              self.csv_name[y]=self.csv_name[y].fillna(x)\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          elif self.choice==2:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              self.csv_name[y]=self.csv_name[y].fillna(self.csv_name[y].mean())\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          elif self.choice==3:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              self.csv_name[y]=self.csv_name[y].fillna(self.csv_name[y].median())\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          elif self.choice==4:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              self.csv_name[y]=self.csv_name[y].fillna(self.csv_name[y].min())\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          else:\n",
        "            print(\"\\n[Warning] Invalid option! Please choose a number from 1 to 4.\\n\")\n",
        "        elif self.csv_name[y].dtype==object:\n",
        "          try:\n",
        "            self.choice=int(input(\"Enter:\\n\"\n",
        "                            \"1 for Enter value manually.\\n\"\n",
        "                            \"2 for Fill missing values with Mode.\\n\"\n",
        "                            \"3 for Drop the Row Contains The missing values.\\n\"\n",
        "                            \"4 for Fill The missing values with Defualt --Unknown--.\\n\"\n",
        "                            \"Choose 1,2,3,or 4:\"))\n",
        "          except ValueError:\n",
        "            print(\"Invalid input! Enter a number from 1 to 4.\")\n",
        "            continue\n",
        "          if self.choice==1:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              x=input(\"Enter the Missings Value:\")\n",
        "              self.csv_name[y]=self.csv_name[y].fillna(x)\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          elif self.choice==2:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              mode_series=self.csv_name[y].mode()\n",
        "              if not mode_series.empty:\n",
        "                self.csv_name[y]=self.csv_name[y].fillna(str(mode_series[0]))\n",
        "              else:\n",
        "                self.csv_name[y]=self.csv_name[y].fillna(\"Unknown\")\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          elif self.choice==3:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              self.csv_name.dropna(subset=[y],inplace=True)\n",
        "              print(\"Missing Values Sorted:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          elif self.choice==4:\n",
        "            if self.csv_name[y].isna().any():\n",
        "              self.csv_name[y]=self.csv_name[y].fillna(\"Unknown\")\n",
        "              print(\"Missing Values:\")\n",
        "              print(self.csv_name.isna().sum())\n",
        "              break\n",
        "            else:\n",
        "              print(\"No Missing Values Exist in the Selected Column\")\n",
        "              break\n",
        "          else:\n",
        "            print(\"\\n[Warning] Invalid option! Please choose a number from 1 to 4.\\n\")\n",
        "    def handle_duplicates():\n",
        "      print(\"===Handle Duplicates===\")\n",
        "      print(\"Duplicate Rows:\",self.csv_name.duplicated().sum())\n",
        "      while True:\n",
        "        try:\n",
        "          user=int(input(\"Do Want To Remove Duplicate Rows?\\n\"\n",
        "                        \"Enter:\\n\"\n",
        "                        \"1 for Yes\\n\"\n",
        "                        \"2 for No\\n\"))\n",
        "        except ValueError:\n",
        "          print(\"Invalid input! Enter a number from 1 or 2.\")\n",
        "          continue\n",
        "        if user==1:\n",
        "          self.csv_name.drop_duplicates(inplace=True)\n",
        "          print(\"Duplicate Rows has been Removed:\")\n",
        "          print(\"Duplicate Rows:\",self.csv_name.duplicated().sum())\n",
        "          break\n",
        "        elif user==2:\n",
        "          break\n",
        "        else:\n",
        "          print(\"invalid input! Choose 1 or 2\")\n",
        "    def save_cleaned_dataset():\n",
        "      print(\"===Save The Cleaned Dataset===\")\n",
        "      def Save_to_csv():\n",
        "        while True:  \n",
        "          try:\n",
        "            n=input(\"Enter the Name for New Cleaned Dataset:\")\n",
        "            if not n:\n",
        "              print(\"This feild is required!\")\n",
        "              continue\n",
        "            if not n.endswith(\".csv\"):\n",
        "              n+=\".csv\"\n",
        "            self.csv_name.to_csv(n,index=False)\n",
        "            print(\"Dataset Saved\")\n",
        "            print(\"New File:\\n\",\n",
        "                      n) \n",
        "            break \n",
        "          except Exception as e:\n",
        "            print(\"Could Not Save the File.Details:\",e)\n",
        "            return\n",
        "      def save_to_sql():\n",
        "        while True:  \n",
        "          try:\n",
        "            Host=input(\"Enter host:\")\n",
        "            User=input(\"Enter User Name:\")\n",
        "            Password=input(\"Enter password:\")\n",
        "            conn = mysql.connector.connect(\n",
        "            host=Host,\n",
        "            user=User,\n",
        "            password=Password,\n",
        "            use_pure=True\n",
        "            )\n",
        "  
        "            if conn.is_connected():\n",
        "              engine = create_engine(f\"mysql+mysqlconnector://{User}:{Password}@{Host}/data_analyzer\")\n",
        "              self.csv_name.to_sql(\"cleaned_data\", engine, if_exists=\"replace\", index=False)\n",
        "              print(\"Data saved to MySQL successfully!\")\n",
        "              break\n",
        "          except Exception as e:\n",
        "            print(\"Could Not Connect:\", e) \n",
        "            retry = int(input(\"Try again?\\n\" \"1 for yes.\\n\" \"2 for no.\\n\"\n",
        "                              \"Enter 1 or 2:\"))\n",
        "            if retry == 2:\n",
        "              break        \n",
        "      while True:\n",
        "        try:\n",
        "          g=int(input(\"Select how do want to Save Cleaned Dataset?\\n\"\n",
        "                      \"Enter\\n\"\n",
        "                      \"1 for Save to csv\\n\"\n",
        "                      \"2 for Save to sql\\n\"\n",
        "                      \"Choose 1 or 2:\"))\n",
        "        except ValueError:\n",
        "          print(\"invalid input! Enter 1 or 2.\")\n",
        "          continue\n",
        "        if g==1:\n",
        "          Save_to_csv()\n",
        "          break\n",
        "        elif g==2:\n",
        "          save_to_sql()\n",
        "          break\n",
        "        else:\n",
        "          print(\"invalid input! Enter Number 1 or 2\")\n",
        "\n",
        "    def missing_val_summary():\n",
        "      null_col=[col for col in self.csv_name.columns if self.csv_name[col].isna().sum() > 0]\n",
        "      for i in null_col:\n",
        "        mis_val=self.csv_name[i].isna().sum()\n",
        "        per_mis_val=(self.csv_name[i].isna().sum()/len(self.csv_name.index))*100\n",
        "        print(\"Column:\"+i,\"Missing Values:\"+str(mis_val),\"Percentage:\"+str(per_mis_val),sep=\"  |  \")\n",
        "    def save_json():\n",
        "      with open(\"report.json\",\"w\") as f:\n",
        "        json.dump(report,f)\n",
        "      print(\"Report has been Saved\")\n",
        "    def load_json():\n",
        "      try:\n",
        "        print(\"=======View Cleaning History Report=======\")\n",
        "        with open(\"report.json\",\"r\") as f:\n",
        "          json_data=json.load(f)\n",
        "          print(json.dumps(json_data,indent=4))\n",
        "      except FileNotFoundError:\n",
        "        print(\"Report has not been Saved!\")\n",
        "        return\n",
        "      except json.JSONDecodeError:\n",
        "        print(\"Report file is corrupted or empty.\")\n",
        "    while True:\n",
        "      print(\"Enter:\\n\"\n",
        "          \"1 for Null Handling.\\n\"\n",
        "          \"2 for Handle Duplicates.\\n\"\n",
        "          \"3 for Save Cleaned Dataset.\\n\"\n",
        "          \"4 for Missing Value Summary.\\n\"\n",
        "          \"5 for View Cleaning History\\n\"\n",
        "          \"6 for Back.\\n\")\n",
        "      try:\n",
        "        choose=int(input(\"Choose 1 to 6:\"))\n",
        "      except ValueError:\n",
        "        print(\"Invalid input! Enter a number from 1 to 6.\")\n",
        "        continue\n",
        "      if choose==1:\n",
        "        handle_nulls()\n",
        "      elif choose==2:\n",
        "        handle_duplicates()\n",
        "      elif choose == 3:\n",
        "        save_cleaned_dataset()\n",
        "      elif choose == 4:\n",
        "        missing_val_summary()\n",
        "      elif choose == 5:\n",
        "        load_json()\n",
        "      elif choose == 6:\n",
        "        break\n",
        "      else:\n",
        "        print(\"Invalid input! Enter Number 1 to 6.\")\n",
        "    After_Cleaning={\n",
        "    \"Rows\":len(self.csv_name.index),\n",
        "    \"Missing Values\":self.csv_name.isna().sum().to_dict(),\n",
        "    \"Duplicate Rows\":int(self.csv_name.duplicated().sum())\n",
        "    }\n",
        "    report={\n",
        "          \"Before\":Before_Cleaning,\n",
        "          \"After\":After_Cleaning\n",
        "      }\n",
        "    while True:\n",
        "      try:\n",
        "        save=int(input(\"Do you wanna Save the Cleaning Hisotry Report?\\n\"\n",
        "                       \"Enter:\\n\"\n",
        "                       \"1 for yes\\n\"\n",
        "                       \"2 for no\\n\"\n",
        "                       \"Enter 1 or 2:\"))\n",
        "      except ValueError:\n",
        "        print(\"Invalid input! Enter Number 1 or 2.\")\n",
        "        continue\n",
        "      if save==1:\n",
        "        save_json()\n",
        "        break\n",
        "      elif save==2:\n",
        "        break\n",
        "      else:\n",
        "        print(\"Invalid input! Enter Number 1 or 2.\")     \n",
        "if __name__==\"__main__\":\n",
        "  analyzer=Ai_Data_Analyzer()\n",
        "  while True:\n",
        "    try:\n",
        "      print(\"=========Main Menu=========\")\n",
        "      usr=int(input(\"Enter:\\n\"\n",
        "                    \"1 for Load Dataset\\n\"\n",
        "                    \"2 for Basic Info.\\n\"\n",
        "                    \"3 for Data Cleaing.\\n\"\n",
        "                    \"4 for Quit\\n\"\n",
        "                    \"choose 1 to 4:\"))\n",
        "    except ValueError:\n",
        "      print(\"Invalid input! Enter a number from 1 to 4.\")\n",
        "      continue\n",
        "    if usr==1:\n",
        "      analyzer.Load_Dataset()\n",
        "    elif usr==2:\n",
        "      analyzer.basic_info()\n",
        "    elif usr==3:\n",
        "      analyzer.cleaning_Data()\n",
        "    elif usr==4:\n",
        "      break\n",
        "    else:\n",
        "      print(\"invalid input! Enter int 1 to 4.\")\n"
      ]
    }
  ],
